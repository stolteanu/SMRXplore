# Données patients réelles (RHS/VID-HOSP/valorisation, même anonymisées) —
# ne doivent jamais entrer dans l'historique de version.
input/
data/

# app/ mélange du code source (interface de lancement/exploration) et des
# artefacts générés (tableaux de bord dérivés de données patients réelles —
# établissement, activité, montants) : on ignore tout par défaut, puis on
# ré-autorise explicitement les fichiers SOURCE (jamais les rapports générés
# tableau_de_bord_*/annexe_*/journal_*/generated/, ni app/data/pmsi.db —
# celui-ci déjà couvert par la règle data/ ci-dessus).
app/*
!app/index.html
!app/tdb-choix.html
!app/explorateur.html
!app/catalogue.js
!app/app.js
!app/lib/
!app/lib/**

output/
temp/

__pycache__/
*.pyc

# Config Claude Code locale à cette machine (permissions), pas du projet.
.claude/settings.local.json
